model Model
	culture: es-AR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["bi_turnos","bi_reservas","bi_usuarios"]

annotation PBI_ProTooling = ["DevMode"]

ref table bi_turnos
ref table bi_reservas
ref table bi_usuarios
ref table Calendario

