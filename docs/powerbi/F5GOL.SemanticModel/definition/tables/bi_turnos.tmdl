		sourceColumn: club

	column Hora = HOUR(bi_turnos[hora_inicio])
		dataType: int64
		formatString: 0
		lineageTag: 98d38c7f-cefb-4cf8-843b-f08bd607e959
		summarizeBy: none

	column Franja = SWITCH(TRUE(), bi_turnos[Hora] < 18, "Tarde (antes de 18 hs)", bi_turnos[Hora] < 20, "Previa (18 a 20 hs)", "Noche (desde 20 hs)")
		dataType: string
		lineageTag: b75e507c-1ed2-485d-9f0d-7e47aef382ee
		summarizeBy: none

	column 'Club y cancha' = bi_turnos[club] & " · " & bi_turnos[cancha]
		dataType: string
		lineageTag: bbb741c7-9301-40dd-aad0-f897e4f7b815
		summarizeBy: none

	column 'Tipo de superficie' = SWITCH(bi_turnos[superficie], "cesped_sintetico", "Césped sintético", "cesped_natural", "Césped natural", "cemento", "Cemento", "parquet", "Parquet", "caucho", "Caucho", "Sin especificar")
		dataType: string
		lineageTag: d8ebb0ce-27f7-40c1-adab-e7b8e3e3e6d1
		summarizeBy: none

	partition bi_turnos = m
		mode: import
		source =
				let
				    // Base f5gol del MySQL de XAMPP (usuario root, sin contraseña)
				    Origen = MySQL.Database("localhost", "f5gol", [ReturnSingleDatabase = true]),
				    Vista = Origen{[Schema = "f5gol", Item = "bi_turnos"]}[Data],
				    Tipos = Table.TransformColumnTypes(Vista, {{"turno_id", Int64.Type}, {"fecha", type date}, {"hora_inicio", type time}, {"hora_fin", type time}, {"estado", type text}, {"cupo_maximo", Int64.Type}, {"cancha_id", Int64.Type}, {"cancha", type text}, {"tipo_cancha", type text}, {"superficie", type text}, {"tarifa", type number}, {"cancha_eliminada", Int64.Type}, {"club_id", Int64.Type}, {"club", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table

