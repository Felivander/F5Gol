table bi_turnos
	lineageTag: 06d01180-c419-41a2-a785-28c33e493571

	measure 'Turnos ofrecidos' = CALCULATE(COUNTROWS(bi_turnos), bi_turnos[estado] <> "bloqueado")
		formatString: #,0
		lineageTag: 5b8b6301-f5d8-4e21-ab32-9c979c166897

	measure 'Turnos ocupados' = CALCULATE(COUNTROWS(bi_turnos), bi_turnos[estado] = "ocupado")
		formatString: #,0
		lineageTag: 558554cf-8886-47ce-9eda-6d319a4821ea

	measure '% Ocupación' = DIVIDE([Turnos ocupados], [Turnos ofrecidos])
		formatString: 0.0%
		lineageTag: f0fdb776-12d3-4229-a8cd-6ab0f25e0729

	measure 'Turnos bloqueados' = CALCULATE(COUNTROWS(bi_turnos), bi_turnos[estado] = "bloqueado")
		formatString: #,0
		lineageTag: e2ceed61-2f59-4f49-b42c-cf347526f8c1

	measure '% Ocupación semana anterior' = CALCULATE([% Ocupación], DATEADD(Calendario[Date], -7, DAY))
		formatString: 0.0%
		lineageTag: b9a95809-842a-4b0e-93b4-ee91a6904970

	measure 'Variación de ocupación' = [% Ocupación] - [% Ocupación semana anterior]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: bb196a4b-4fcc-4e99-9e8a-14cf36cd4469

	column turno_id
		dataType: int64
