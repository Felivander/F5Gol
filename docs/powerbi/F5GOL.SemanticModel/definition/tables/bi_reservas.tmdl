table bi_reservas
	lineageTag: 43863286-b893-44e6-9360-cdca9c1d49fa

	measure Reservas = CALCULATE(COUNTROWS(bi_reservas), bi_reservas[estado] <> "cancelada")
		formatString: #,0
		lineageTag: c4476738-a34b-4caa-9502-89fd684b4fe1

	measure 'Reservas canceladas' = CALCULATE(COUNTROWS(bi_reservas), bi_reservas[estado] = "cancelada")
		formatString: #,0
		lineageTag: 4f2b9563-9937-4aac-b543-d9dafccf8b2c

	measure '% Cancelación' = DIVIDE([Reservas canceladas], COUNTROWS(bi_reservas))
		formatString: 0.0%
		lineageTag: 931e3943-0667-45cf-91fe-57526e27b51e

	measure 'Reservas completas' = CALCULATE([Reservas], bi_reservas[tipo] = "completa")
		formatString: #,0
		lineageTag: 836e3812-c7fd-408f-a95a-de38a4f899d5

	measure 'Inscripciones de matchmaking' = CALCULATE([Reservas], bi_reservas[tipo] = "individual")
		formatString: #,0
		lineageTag: 33e1493e-ca79-4c06-9482-a1ac7a003a10

	measure 'Partidos armados por matchmaking' = CALCULATE(DISTINCTCOUNT(bi_reservas[turno_id]), bi_reservas[tipo] = "individual", bi_reservas[estado] <> "cancelada", bi_turnos[estado] = "ocupado")
		formatString: #,0
		lineageTag: 3fba3ae1-6c5c-47a1-85da-718821efffe7

	measure '% Partidos por matchmaking' = DIVIDE([Partidos armados por matchmaking], [Turnos ocupados])
		formatString: 0.0%
		lineageTag: c0966f2e-650d-4ed8-a162-af25410417b0

	measure Facturación = CALCULATE(SUM(bi_reservas[monto]), bi_reservas[estado] <> "cancelada")
		formatString: $ #,0
		lineageTag: ac488057-e3d6-4dd1-a067-10bcabb2b485

	measure Cobrado = CALCULATE([Facturación], bi_reservas[estado_pago] = "pagado")
		formatString: $ #,0
		lineageTag: ad3a19bb-da34-4948-904f-60d0dcb102eb

	measure 'Con seña' = CALCULATE([Facturación], bi_reservas[estado_pago] = "sena")
		formatString: $ #,0
		lineageTag: 5fc38b95-e9e7-437f-a289-f0b6fec62549

	measure 'Pendiente de cobro' = CALCULATE([Facturación], bi_reservas[estado_pago] = "pendiente")
		formatString: $ #,0
		lineageTag: d2edcb25-6a59-4140-b99d-f2edd9d62272

	measure '% Cobrado' = DIVIDE([Cobrado], [Facturación])
		formatString: 0.0%
		lineageTag: ed0a9494-6129-4f17-b64a-51a6705a7e3f

	measure 'Ticket promedio' = DIVIDE([Facturación], [Reservas])
		formatString: $ #,0
		lineageTag: f54a9f27-2788-485f-bdf3-c743eec36458

