	partition bi_reservas = m
		mode: import
		source =
				let
				    // Base f5gol del MySQL de XAMPP (usuario root, sin contraseña)
				    Origen = MySQL.Database("localhost", "f5gol", [ReturnSingleDatabase = true]),
				    Vista = Origen{[Schema = "f5gol", Item = "bi_reservas"]}[Data],
				    Tipos = Table.TransformColumnTypes(Vista, {{"reserva_id", Int64.Type}, {"tipo", type text}, {"cantidad_jugadores", Int64.Type}, {"estado", type text}, {"estado_pago", type text}, {"reservada_en", type datetime}, {"usuario_id", Int64.Type}, {"rol_usuario", type text}, {"turno_id", Int64.Type}, {"fecha", type date}, {"hora_inicio", type time}, {"cancha_id", Int64.Type}, {"cancha", type text}, {"superficie", type text}, {"club_id", Int64.Type}, {"club", type text}, {"tarifa", type number}, {"monto", type number}})
				in
				    Tipos

	annotation PBI_ResultType = Table

