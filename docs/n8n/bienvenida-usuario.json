    {
      "parameters": {
        "jsCode": "// Revisa que el pedido venga de F5GOL y que los datos sirvan para mandar el mail.\nconst entrada = $input.first().json;\nconst encabezados = entrada.headers || {};\nconst cuerpo = entrada.body || {};\nconst usuario = cuerpo.usuario || {};\n\nlet codigo = 200;\nlet motivo = '';\n\n// Si en \"Configuración\" hay un secreto, tiene que coincidir con el que manda Laravel\nconst secretoRecibido = encabezados['x-f5gol-secreto'] || '';\nif (entrada.secreto_esperado && secretoRecibido !== entrada.secreto_esperado) {\n  codigo = 401;\n  motivo = 'El secreto del encabezado X-F5GOL-Secreto no es válido.';\n} else if (cuerpo.evento !== 'usuario.creado') {\n  codigo = 422;\n  motivo = 'Evento desconocido: se esperaba usuario.creado.';\n} else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(usuario.email || '')) {\n  codigo = 422;\n  motivo = 'El usuario no tiene un email válido.';\n}\n\nconst nombreCompleto = String(usuario.nombre || '').trim();\nconst links = cuerpo.links || {};\n\nreturn [{\n  json: {\n    valido: codigo === 200,\n    codigo,\n    motivo,\n    usuario_id: usuario.id,\n    nombre_completo: nombreCompleto,\n    // Para el saludo alcanza con el primer nombre\n    nombre: nombreCompleto.split(/\\s+/)[0] || 'crack',\n    email: String(usuario.email || '').toLowerCase(),\n    rol: usuario.rol === 'administrador' ? 'administrador' : 'jugador',\n    origen: cuerpo.origen === 'google' ? 'tu cuenta de Google' : 'el formulario de registro',\n    link_app: links.app || '',\n    link_login: links.login || '',\n    link_primer_paso: links.primer_paso || links.app || '',\n    remitente: entrada.remitente,\n    app_nombre: entrada.app_nombre,\n  },\n}];\n"
      },
