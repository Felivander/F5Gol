            {
              "id": "afd20c8b-ded9-4d90-9ade-a39962f54267",
              "name": "asunto",
              "value": "=¡Bienvenido a F5GOL, {{ $json.nombre }}! Cargá tu club y empezá a recibir reservas",
              "type": "string"
            },
            {
              "id": "b7868fa9-d6aa-414a-8dd4-12898f18ff24",
              "name": "html",
              "value": "=<div style=\"margin:0;padding:24px 12px;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a;\"><div style=\"max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e2e8f0;\"><div style=\"background:#065f46;padding:20px 24px;color:#ffffff;font-size:22px;font-weight:bold;\">⚽ F5<span style=\"color:#34d399;\">GOL</span></div><div style=\"padding:24px;\"><h1 style=\"margin:0 0 12px;font-size:22px;\">¡Hola, {{ $json.nombre }}! Tu complejo ya puede estar en F5GOL</h1><p style=\"margin:0 0 16px;line-height:1.5;\">Creaste tu cuenta de <strong>administrador</strong>. En tres pasos tus canchas quedan publicadas para que los jugadores reserven online, sin llamadas ni planillas.</p><ol style=\"margin:0 0 20px;padding-left:20px;line-height:1.5;\"><li style=\"margin:0 0 8px;\"><strong>Creá tu club</strong> con nombre, dirección, fotos y descripción.</li><li style=\"margin:0 0 8px;\"><strong>Agregá tus canchas</strong>: superficie, si es techada, iluminación, vestuarios y tarifa.</li><li style=\"margin:0 0 8px;\"><strong>Cargá los horarios</strong> de cada cancha y seguí las reservas desde el panel.</li></ol><p style=\"margin:0 0 24px;\"><a href=\"{{ $json.link_primer_paso }}\" style=\"display:inline-block;background:#059669;color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 20px;border-radius:8px;\">Cargar mi club</a></p><p style=\"margin:0;color:#64748b;font-size:13px;line-height:1.5;\">Te registraste con {{ $json.origen }} usando {{ $json.email }}. Si no fuiste vos, ignorá este mail.</p></div></div></div>",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
