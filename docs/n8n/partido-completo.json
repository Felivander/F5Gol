    {
      "parameters": {
        "jsCode": "// Revisa el pedido y devuelve un ítem por cada jugador al que hay que avisar.\nconst entrada = $input.first().json;\nconst encabezados = entrada.headers || {};\nconst cuerpo = entrada.body || {};\n\nconst rechazo = (codigo, motivo) => [{ json: { valido: false, codigo, motivo } }];\n\nconst secretoRecibido = encabezados['x-f5gol-secreto'] || '';\nif (entrada.secreto_esperado && secretoRecibido !== entrada.secreto_esperado) {\n  return rechazo(401, 'El secreto del encabezado X-F5GOL-Secreto no es válido.');\n}\nif (cuerpo.evento !== 'partido.completo') {\n  return rechazo(422, 'Evento desconocido: se esperaba partido.completo.');\n}\n\nconst esMail = (m) => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(m || '');\nconst jugadores = (cuerpo.jugadores || []).filter(j => esMail(j.email));\nif (jugadores.length === 0) {\n  return rechazo(422, 'No hay jugadores con un email válido para avisar.');\n}\n\nconst turno = cuerpo.turno || {};\nconst cancha = cuerpo.cancha || {};\nconst club = cuerpo.club || {};\nconst links = cuerpo.links || {};\n\nreturn jugadores.map(j => {\n  const nombre = String(j.nombre || '').trim().split(/\\s+/)[0] || 'crack';\n  const extra = Number(j.cantidad_jugadores || 1) - 1;\n  return {\n    json: {\n      valido: true,\n      codigo: 200,\n      email: String(j.email).toLowerCase(),\n      nombre,\n      con_amigos: (j.tipo === 'equipo' ? `Reservaste el Equipo ${j.equipo || 'A'} entero.`\n        : `Jugás en el Equipo ${j.equipo || 'A'}.` + (extra > 0 ? ` Te anotaste con ${extra} ${extra === 1 ? 'amigo' : 'amigos'}.` : '')),\n      dia: turno.dia || turno.fecha || '',\n      horario: `${turno.hora_inicio || ''} a ${turno.hora_fin || ''}`,\n      cupo: turno.cupo_maximo || '',\n      cancha: cancha.nombre || 'la cancha',\n      club: club.nombre || '',\n      direccion: club.direccion || '',\n      telefono: club.telefono || '',\n      link: links.mis_reservas || links.cancha || '',\n      remitente: entrada.remitente,\n    },\n  };\n});\n"
      },
