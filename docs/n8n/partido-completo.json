      "id": "0cd4be18-f93f-44c1-b627-99727ea7b268",
      "name": "Enviar aviso",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        -200
      ],
      "webhookId": "b052d207-4f2c-4d7b-8843-aacf749bab07",
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP F5GOL"
        }
