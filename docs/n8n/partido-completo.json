              "name": "asunto",
              "value": "=¡Se completó tu partido del {{ $json.dia }} a las {{ $json.horario.split(\" a \")[0] }}!",
              "type": "string"
            },
            {
              "id": "a7a49415-f897-4e1a-92da-ce249000249a",
              "name": "html",
              "value": "=<div style=\"margin:0;padding:32px 12px;background:#f5f2ea;font-family:'Archivo','Segoe UI',Helvetica,Arial,sans-serif;color:#15171a;\"><div style=\"max-width:560px;margin:0 auto;\"><div style=\"background:#15171a;border-radius:14px 14px 0 0;padding:16px 24px;\"><span style=\"display:inline-block;background:#cff04a;color:#15171a;font-weight:800;font-size:13px;line-height:1;padding:7px 6px;border-radius:7px;vertical-align:middle;\">F5</span><span style=\"display:inline-block;color:#ffffff;font-weight:800;font-size:19px;letter-spacing:-0.2px;vertical-align:middle;margin-left:10px;\">F5GOL</span></div><div style=\"background:#0e5e3a;padding:28px 24px 26px;\"><p style=\"margin:0 0 10px;color:#cff04a;font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;\">Partido completo</p><h1 style=\"margin:0;color:#ffffff;font-size:28px;line-height:1.15;font-weight:800;letter-spacing:-0.5px;\">¡{{ $json.nombre }}, se completó tu partido!</h1></div><div style=\"background:#ffffff;border:1px solid #e3ded2;border-top:0;border-radius:0 0 14px 14px;padding:24px;\"><p style=\"margin:0 0 16px;font-size:15px;line-height:1.55;color:#15171a;\">Ya están los {{ $json.cupo }} jugadores: el turno quedó confirmado.</p><p style=\"margin:0 0 20px;background:#f2fbcf;border:1px solid #cff04a;border-radius:10px;padding:12px 14px;font-size:15px;font-weight:700;color:#15171a;\">{{ $json.con_amigos }}</p><table role=\"presentation\" style=\"width:100%;border-collapse:separate;background:#f5f2ea;border:1px solid #e3ded2;border-radius:12px;margin:0 0 16px;\"><tr><td style=\"padding:16px 18px;\"><p style=\"margin:0 0 4px;color:#0e5e3a;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;\">{{ $json.club }}</p><p style=\"margin:0 0 6px;font-size:22px;font-weight:800;letter-spacing:-0.3px;color:#15171a;\">{{ $json.cancha }}</p><p style=\"margin:0;font-size:15px;color:#15171a;\"><span style=\"text-transform:capitalize;font-weight:700;\">{{ $json.dia }}</span> · {{ $json.horario }}</p><p style=\"margin:6px 0 0;font-size:13px;color:#5b5f66;\">{{ $json.direccion }}</p></td></tr></table><p style=\"margin:4px 0 0;\"><a href=\"{{ $json.link }}\" style=\"display:inline-block;background:#cff04a;color:#15171a;text-decoration:none;font-weight:800;font-size:15px;padding:14px 22px;border-radius:10px;\">Ver mis reservas</a></p><p style=\"margin:20px 0 0;padding-top:16px;border-top:1px solid #e3ded2;color:#5b5f66;font-size:13px;line-height:1.5;\">Si no podés ir, cancelá desde Mis reservas antes de que empiece para que otro tome tu lugar. Consultas al club: {{ $json.telefono }}.</p></div><p style=\"margin:16px 4px 0;color:#5b5f66;font-size:12px;line-height:1.5;\">F5GOL · Turnos y partidos de fútbol 5 · Concordia, Entre Ríos</p></div></div>",
