    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Junta el resultado de todos los envíos en una sola respuesta para Laravel.\nconst mails = $('Armar mail').all().map(i => i.json.email);\nconst resultados = $input.all();\nconst fallidos = [];\nresultados.forEach((r, i) => {\n  if (r.json.error) {\n    fallidos.push({ email: mails[i], error: r.json.error.message || String(r.json.error) });\n  }\n});\nconst enviados = resultados.length - fallidos.length;\nreturn [{\n  json: {\n    ok: fallidos.length === 0,\n    codigo: fallidos.length === 0 ? 200 : 502,\n    mensaje: fallidos.length === 0\n      ? (enviados === 1 ? 'Se avisó al jugador que el partido se completó.' : `Se avisó a los ${enviados} jugadores que el partido se completó.`)\n      : `Se mandaron ${enviados} de ${resultados.length} mails; fallaron ${fallidos.length}.`,\n    enviados,\n    fallidos,\n  },\n}];\n"
      },
      "id": "5067d469-6e9a-40db-b5e8-f07f2c8168e5",
      "name": "Resumir envíos",
